# generated artifacts and local runtime state
artifacts/

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/
.pyright/
*.egg-info/

# virtual environments
.conda/
.venv/
venv/

# rust / native extension build output (native/xlsbkernel/) — never commit
# compiled artifacts; Cargo.lock IS committed for reproducible builds
native/*/target/
*.so
*.pyd

# generated artifacts — never commit deliverables, fixtures, reports, or run data
tests/fixtures/generated/
runs/
reports/
data/
*.sqlite3
dist/
build/
*.qca
*.log
