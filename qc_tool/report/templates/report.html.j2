<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>QC Report — {{ result.profile_name }}</title>
<style>
  :root { color-scheme: light; }
  body { font-family: "Segoe UI", system-ui, sans-serif; margin: 2rem; color: #1a1a1a; }
  h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .meta { color: #555; font-size: 0.85rem; margin-bottom: 1rem; }
  .note { background: #fff4f4; border-left: 4px solid #c00000; padding: 0.5rem 0.75rem;
          margin: 0.5rem 0; font-size: 0.9rem; }
  .cards { display: flex; gap: 0.75rem; margin: 1rem 0; flex-wrap: wrap; }
  .card { border-radius: 8px; padding: 0.6rem 1.1rem; color: #fff; min-width: 7rem; }
  .card .n { font-size: 1.4rem; font-weight: 700; display: block; }
  .card .affected { display: block; font-size: 0.7rem; margin-top: 0.15rem; }
  .critical { background: #c00000; } .warning { background: #ed7d31; }
  .info { background: #2e75b6; } .expected { background: #548235; }
  .filters { margin: 0.5rem 0 1rem; font-size: 0.9rem; }
  .filters label { margin-right: 1rem; user-select: none; }
  table { border-collapse: collapse; width: 100%; font-size: 0.82rem; }
  th, td { border: 1px solid #ddd; padding: 0.35rem 0.5rem; text-align: left;
           vertical-align: top; }
  th { background: #262626; color: #fff; position: sticky; top: 0; }
  td.sev { font-weight: 700; color: #fff; text-align: center; white-space: nowrap; }
  tr.critical td.sev { background: #c00000; } tr.warning td.sev { background: #ed7d31; }
  tr.info td.sev { background: #2e75b6; } tr.expected td.sev { background: #548235; }
  td.mono { font-family: ui-monospace, monospace; }
  .impacts { color: #555; font-size: 0.78rem; }
  .coverage { margin: 1rem 0 1.25rem; }
  details > summary { cursor: pointer; color: #2e5f96; }
  .member-table { margin-top: 0.5rem; }
  .range-list { white-space: pre-wrap; }
  .member-pages { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.45rem; }
  .member-pages button { border: 1px solid #bbb; background: #fff; padding: 0.2rem 0.55rem;
    border-radius: 3px; cursor: pointer; }
  .member-pages button:disabled { color: #999; cursor: default; }
  /* formula token diff */
  .formula-diff { font-family: ui-monospace, monospace; white-space: pre-wrap; overflow-wrap: anywhere; max-height: 14rem; overflow: auto; padding: 0.35rem; border: 1px solid #eee; border-radius: 4px; }
  .formula-diff .fdiff-equal { color: #1a1a1a; }
  .formula-diff .fdiff-removed { color: #c00000; text-decoration: line-through; background: rgba(192,0,0,0.04); }
  .formula-diff .fdiff-added { color: #548235; text-decoration: underline; background: rgba(84,130,53,0.04); }
</style>
</head>
<body>
<h1>QC Report — {{ result.profile_name }}</h1>
<div class="meta">
  Generated {{ generated_at }} (UTC)
  | mode: <strong>{{ result.mode.value }}</strong>
  | output: <strong>{{ result.requested_output_mode.value }}</strong>
  {% for role, engine in result.formula_engines.items() %} | formula engine {{ role }}: <strong>{{ engine }}</strong>{% endfor %}
  {% for role, engine in result.values_engines.items() %} | values engine {{ role }}: <strong>{{ engine }}</strong>{% endfor %}
  {% for role, name in result.files.items() %} | {{ role }}: <strong>{{ name }}</strong>{% endfor %}
  | verified cross-checks: {{ result.verified_crosschecks }}
  {% if capability_limited %} | <strong class="capability-limited">capability-limited</strong>{% endif %}
</div>
{% if configuration %}
<h2>Resolved configuration</h2>
<div class="meta">
  Digest: <strong class="mono">{{ configuration.digest }}</strong> |
  members: {{ configuration.member_count }} |
  sheets: {{ configuration.sheet_count }} |
  regions: {{ configuration.region_count }} |
  selectors: {{ configuration.selector_count }} |
  excluded regions: {{ configuration.excluded_regions }} |
  accepted degradations: {{ configuration.degraded_regions }} |
  acknowledgements: {{ configuration.acknowledgement_count }} |
  run overrides: {{ configuration.override_count }}
</div>
<div class="meta">Region coverage: {{ configuration.coverage_text }}</div>
{% endif %}
{% if capability_limited %}
<div class="note">One or more required checks were unavailable, so a low finding
count is not a clean result. Review the check coverage table below.</div>
{% endif %}
{% if result.package_manifest and not result.package_manifest.is_legacy_projection %}
<h2>Package members</h2>
<table class="coverage">
  <thead><tr><th>Side</th><th>Artifact</th><th>Member</th><th>Display name</th></tr></thead>
  <tbody>
  {% for member in result.package_manifest.members %}
  <tr><td>{{ member.side.value }}</td><td>{{ member.artifact.value }}</td>
    <td class="mono">{{ member.member_id }}</td><td>{{ member.display_name }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}
{% if result.mapping_coverage %}
<h2>Mapping coverage</h2>
<div class="meta">
  {{ result.mapping_coverage.eligible }} readable |
  {{ result.mapping_coverage.unavailable }} unavailable |
  {{ result.mapping_coverage.eligible + result.mapping_coverage.unavailable }} total surfaces |
  {{ result.mapping_coverage.mapped }} mapped |
  {{ result.mapping_coverage.verified }} verified |
  {{ result.mapping_coverage.mismatched }} mismatched |
  {{ result.mapping_coverage.unresolved }} unresolved |
  {{ result.mapping_coverage.unmapped }} unmapped
</div>
{% endif %}
<h2>Check coverage</h2>
<table class="coverage">
  <thead><tr><th>Artifact</th><th>Check</th><th>Status</th><th>Findings</th><th>Detail</th></tr></thead>
  <tbody>
  {% for item in result.coverage %}
  <tr><td>{{ item.artifact }}</td><td>{{ item.label }}</td><td>{{ item.state.value }}</td>
    <td>{{ item.findings }}</td><td>{{ item.detail }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% for disclosure in result.disclosures %}
<div class="note">{{ disclosure }}</div>
{% endfor %}
{% if not atomics_included %}
<div class="note">This run produced {{ result.findings | length }} finding
records, above the {{ atomics_threshold }}-row inline limit for a single
HTML file, so per-finding detail is not embedded here. Every decision,
story, and coverage row below is complete; the Excel and JSON exports and
the review app carry every finding record.</div>
{% endif %}
{% if result.alignment_trust %}
<h2>Alignment trust</h2>
<div class="meta">Per-region pairing counts and low-confidence/unpaired indicators.</div>
<table class="coverage">
  <thead><tr><th>Member</th><th>Sheet</th><th>Region</th>
    <th>Baseline range</th><th>Current range</th>
    <th>Row method</th><th>Row fallback</th><th>Rows p/d/i/g</th>
    <th>Col method</th><th>Col fallback</th><th>Cols p/d/i/g</th>
    <th>Cell pairs</th><th>Skipped cells</th><th>Low confidence</th></tr></thead>
  <tbody>
  {% for r in result.alignment_trust.regions %}
  <tr>
    <td>{{ r.artifact_member }}</td>
    <td>{{ r.sheet }}</td>
    <td class="mono">{{ r.region_id }}</td>
    <td class="mono">{{ r.baseline_range }}</td>
    <td class="mono">{{ r.current_range }}</td>
    <td>{{ r.row.method }}</td>
    <td>{{ r.row.low_confidence_fallback }}</td>
    <td>{{ r.row.paired }}/{{ r.row.deleted }}/{{ r.row.inserted }}/{{ r.row.growth }}</td>
    <td>{{ r.column.method }}</td>
    <td>{{ r.column.low_confidence_fallback }}</td>
    <td>{{ r.column.paired }}/{{ r.column.deleted }}/{{ r.column.inserted }}/{{ r.column.growth }}</td>
    <td>{{ r.comparable_cell_pairs }}</td>
    <td>{{ r.skipped_low_confidence_cells }}</td>
    <td>{{ r.low_confidence }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% if result.alignment_trust.unpaired %}
<h3>Unpaired regions</h3>
<table class="coverage">
  <thead><tr><th>Side</th><th>Member</th><th>Sheet</th><th>Region</th><th>Range</th><th>Orientation</th></tr></thead>
  <tbody>
  {% for u in result.alignment_trust.unpaired %}
  <tr>
    <td>{{ u.side }}</td>
    <td>{{ u.artifact_member }}</td>
    <td>{{ u.sheet }}</td>
    <td class="mono">{{ u.region_id }}</td>
    <td class="mono">{{ u.cell_range }}</td>
    <td>{{ u.orientation }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}
{% endif %}
{% if stories %}
<h2>Change stories</h2>
<div class="meta">Cross-class narrative synthesis; severities and counts are
unchanged — stories are a lens over the same findings.</div>
<table class="coverage">
  <thead><tr><th>Story</th><th>Kind</th><th>Narrative</th><th>Findings</th><th>Severity mix</th></tr></thead>
  <tbody>
  {% for story in stories %}
  <tr>
    <td class="mono">{{ story.story_id }}</td>
    <td class="mono">{{ story.kind.value }}</td>
    <td>
      <strong>{{ story.title }}</strong>
      <div>{{ story.description }}</div>
      {% for line in story.evidence %}<div class="mono">{{ line }}</div>{% endfor %}
    </td>
    <td>{{ story.member_count }}</td>
    <td>{% for name, count in story.severity_counts.items() if count %}{{ name }}: {{ count }}{% if not loop.last %} | {% endif %}{% endfor %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}
<div class="cards">
  {% for severity, count in counts.review_items.items() %}
  <div class="card {{ severity.value }}"><span class="n">{{ count }}</span>
    {{ severity.value }} pattern review items
    <span class="affected">{{ counts.atomic_findings[severity] }} finding record{% if counts.atomic_findings[severity] != 1 %}s{% endif %}</span>
    {% if counts.represented_changes is not none %}
    <span class="affected">{{ counts.represented_changes[severity] }} represented change{% if counts.represented_changes[severity] != 1 %}s{% endif %}</span>
    {% endif %}
  </div>
  {% endfor %}
</div>
<div class="filters">
  Show:
  {% for severity in counts.review_items %}
  <label><input type="checkbox" data-sev="{{ severity.value }}"
    {% if severity.value != 'expected' %}checked{% endif %}> {{ severity.value }}</label>
  {% endfor %}
</div>
<table id="findings">
  <thead><tr>
    <th>Group</th><th>Severity</th><th>Class</th><th>Sheet / Slide</th>
    <th>Affected range</th><th>Findings</th><th>Review item</th>
  </tr></thead>
  {% for group in groups %}
  <tbody class="review-item" data-sev="{{ group.severity.value }}">
    <tr class="{{ group.severity.value }} review-group">
      <td class="mono">{{ group.group_id }}</td>
      <td class="sev">{{ group.severity.value }}</td>
      <td class="mono">{{ group.finding_class.value }}</td>
      <td>{% if group.artifact_member != 'primary' %}<span class="mono">{{ group.artifact_member }}</span> · {% endif %}{{ group.sheet or group.slide or "" }}</td>
      <td class="mono range-list">{{ group.ranges | join("; ") or group.bounding_range }}</td>
      <td>{{ group.member_count }}</td>
      <td>{% if group.member_count == 1 %}{{ group.members[0].message }}{% else %}
        {{ group.member_count }} {{ group.finding_class.value | replace("_", " ") }} findings
        {% endif %}</td>
    </tr>
    <tr><td colspan="7">
      {%- if atomics_included %}
      <details><summary>View {{ group.member_count }} finding record{% if group.member_count != 1 %}s{% endif %}</summary>
        <table class="member-table">
          <thead><tr><th>ID</th><th>Severity</th>{% if result.package_manifest and not result.package_manifest.is_legacy_projection %}<th>Member</th>{% endif %}<th>Location</th><th>Element</th>
            <th>Baseline</th><th>Current</th><th>Message</th><th>Analyst comment</th>
            <th>Root cause</th><th>Waiver</th><th>Provenance</th><th>Subtype</th>
            <th>Materiality</th><th>Temporal context</th><th>Expected reason</th>
            <th>Evidence tags</th><th>Population</th></tr></thead>
          <tbody data-member-body="{{ group.group_id }}"></tbody>
        </table>
        <div class="member-pages" data-member-controls="{{ group.group_id }}">
          <button type="button" data-member-previous>Previous</button>
          <span data-member-label></span>
          <button type="button" data-member-next>Next</button>
        </div>
        <script type="application/json" data-members="{{ group.group_id }}">{{ member_payload[group.group_id] | tojson }}</script>
      </details>
      {%- else %}
      <span class="meta">Atomic detail is in the Excel/JSON exports and the review app.</span>
      {%- endif %}
    </td></tr>
  </tbody>
  {% endfor %}
</table>
<script>
  const boxes = document.querySelectorAll('.filters input');
  function apply() {
    const visible = new Set([...boxes].filter(b => b.checked).map(b => b.dataset.sev));
    document.querySelectorAll('#findings tbody.review-item').forEach(group => {
      group.style.display = visible.has(group.dataset.sev) ? '' : 'none';
    });
  }
  boxes.forEach(box => box.addEventListener('change', apply));
{%- if atomics_included %}
  const pageSize = 50;
  function textCell(row, value, className = '') {
    const cell = document.createElement('td');
    cell.textContent = value || '';
    if (className) cell.className = className;
    row.appendChild(cell);
    return cell;
  }
  document.querySelectorAll('details').forEach(details => {
    let pageIndex = 0;
    let members = null;
    const groupId = details.querySelector('[data-member-body]').dataset.memberBody;
    const body = details.querySelector('[data-member-body]');
    const controls = details.querySelector(`[data-member-controls="${groupId}"]`);
    const previous = controls.querySelector('[data-member-previous]');
    const next = controls.querySelector('[data-member-next]');
    const label = controls.querySelector('[data-member-label]');
    function renderPage() {
      if (!members) members = JSON.parse(details.querySelector('[data-members]').textContent);
      const start = pageIndex * pageSize;
      const end = Math.min(start + pageSize, members.length);
      body.replaceChildren();
      members.slice(start, end).forEach(member => {
        const row = document.createElement('tr');
        textCell(row, member.finding_id, 'mono');
        textCell(row, member.severity + (member.overridden ? ' *' : ''));
        if (member.artifact_member !== 'primary') {
          textCell(row, member.artifact_member, 'mono');
        } else if ({{ 'true' if result.package_manifest and not result.package_manifest.is_legacy_projection else 'false' }}) {
          textCell(row, 'primary', 'mono');
        }
        textCell(row, member.location, 'mono');
        textCell(row, member.element);
        textCell(row, member.baseline, 'mono');
        textCell(row, member.current, 'mono');
        const message = textCell(row, member.message);
        if (member.impacts) {
          const impacts = document.createElement('div');
          impacts.className = 'impacts';
          impacts.textContent = `impacts: ${member.impacts}`;
          message.appendChild(impacts);
        }
        // Formula token diff details (safe DOM creation, textContent only)
        if (member.formula_diff && member.formula_diff.length) {
          const diffDetails = document.createElement('details');
          diffDetails.className = 'formula-diff-details';
          const summary = document.createElement('summary');
          summary.textContent = 'Formula token diff';
          diffDetails.appendChild(summary);
          const container = document.createElement('div');
          container.className = 'formula-diff';
          container.setAttribute('role', 'group');
          container.setAttribute('aria-label', 'Formula token diff');
          member.formula_diff.forEach(seg => {
            const span = document.createElement('span');
            span.className = `fdiff-${seg.kind}`;
            span.textContent = seg.text;
            container.appendChild(span);
          });
          diffDetails.appendChild(container);
          message.appendChild(diffDetails);
        }
        textCell(row, member.comment);
        textCell(row, member.root, 'mono');
        textCell(row, member.waiver);
        textCell(row, member.provenance, 'mono');
        textCell(row, member.subtype, 'mono');
        textCell(row, member.materiality, 'mono');
        textCell(row, member.temporal_context, 'mono');
        textCell(row, member.expected_reason, 'mono');
        textCell(row, member.evidence_tags, 'mono');
        textCell(row, member.population, 'mono');
        body.appendChild(row);
      });
      label.textContent = `${start + 1}-${end} of ${members.length}`;
      previous.disabled = pageIndex === 0;
      next.disabled = end >= members.length;
    }
    details.addEventListener('toggle', () => { if (details.open) renderPage(); });
    previous.addEventListener('click', () => { pageIndex -= 1; renderPage(); });
    next.addEventListener('click', () => { pageIndex += 1; renderPage(); });
  });
{%- endif %}
  apply();
</script>
</body>
</html>
