{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence-diff.local/schema/findings-v3.json",
  "title": "cadence-diff findings export v3 (group-first populations)",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "profile",
    "requested_output_mode",
    "resolved_output_policy",
    "formula_engines",
    "values_engines",
    "files",
    "counts",
    "coverage",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "schema": {"const": "https://cadence-diff.local/schema/findings-v3.json"},
    "generated_at": {"type": "string"},
    "context_included": {"type": "boolean"},
    "mode": {"type": "string"},
    "profile": {"type": "string"},
    "requested_output_mode": {"enum": ["profile", "decision", "atomic"]},
    "resolved_output_policy": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["version", "output_mode", "populations", "source"],
          "properties": {
            "version": {"const": 1},
            "output_mode": {"enum": ["profile", "decision", "atomic"]},
            "populations": {
              "type": "object",
              "required": ["enabled", "threshold", "classes", "max_rectangles", "max_explicit_pairs"],
              "properties": {
                "enabled": {"type": "boolean"},
                "threshold": {"type": "integer", "minimum": 1},
                "classes": {"type": "array", "items": {"enum": ["formula_logic_changed", "number_format_changed"]}, "uniqueItems": true},
                "max_rectangles": {"type": "integer", "minimum": 1},
                "max_explicit_pairs": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            },
            "source": {"enum": ["profile", "decision_built_in", "atomic_forced"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "formula_engines": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "values_engines": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "comparison_scope": {"type": "object"},
    "files": {"type": "object", "additionalProperties": {"type": "string"}},
    "counts": {"type": "object", "additionalProperties": {"type": "integer"}},
    "disclosures": {"type": "array", "items": {"type": "string"}},
    "coverage": {"type": "array", "items": {"type": "object"}},
    "mapping_coverage": {"type": ["object", "null"]},
    "mapping_suggestions": {"type": "array", "items": {"type": "object"}},
    "verified_crosschecks": {"type": "integer"},
    "review_summary": {"type": "object"},
    "package_manifest": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
